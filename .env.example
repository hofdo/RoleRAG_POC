APP_ENV=local
DATABASE_PATH=data/rolerag.db
CONTENT_ROOT=data

LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=chatgpt-onnechan
LOCAL_LLM_MAX_TOKENS=500
# Critic/memory JSON budget. Verbose models (Qwen3.6) truncate mid-JSON at 350; 640 fits.
LOCAL_STRUCTURED_MAX_TOKENS=640
LOCAL_LLM_TEMPERATURE=0.75
LOCAL_LLM_TIMEOUT_SECONDS=300
LOCAL_LLM_MAX_RETRIES=1

# Recommended for long sessions on local models. The 2026-06-15 38-turn A/B sweep
# on the 26B model found top_k=10 (the default below) recalled every seeded story
# event, while RAG_RECENCY_WEIGHT / RAG_INDEX_IMPORTANCE_FLOOR /
# RAG_WRITE_DEDUP_COSINE_THRESHOLD / CANON_IMPORTANCE_FLOOR showed no gain — keep
# their defaults. Also recommended:
#   LOCAL_MODEL_PROFILE=26b
#   LOCAL_LLM_MAX_RETRIES=1
# Hosts with the local GGUFs can use LOCAL_MODEL_PROFILE=26b-mtp instead (same 26B
# weights, ~10-14% faster via speculative decoding; see docs/16).

CRITIC_GATING=always
CURATOR_GATING=always
# always = run critic/curator on every turn (current default)
# auto   = skip critic on low-risk turns and the LLM curator when no durable-event
#          signals exist; the deterministic promise extractor always runs

CLOUD_MODE=ask
# Gates cloud SESSION CREATION only (provider is chosen once at session creation and is
# immutable for that session's lifetime — there is no per-turn routing or fallback):
# off  = reject creation of cloud sessions (400 cloud_unavailable)
# ask  = require interactive confirmation when creating a cloud session (CLI typer.confirm,
#        SPA window.confirm); once confirmed, the whole session runs on cloud with no
#        further prompts
# auto = silently allow creation of cloud sessions
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=replace_me
CLOUD_LLM_MODEL=gpt-4.1-mini
CLOUD_LLM_MAX_TOKENS=1000
CLOUD_LLM_TEMPERATURE=0.65
CLOUD_LLM_TIMEOUT_SECONDS=120
CLOUD_LLM_MAX_RETRIES=1

QDRANT_URL=http://localhost:6333
# Opt-in INT8 scalar quantization for Qdrant collections (P2.1, docs/22). Applies only when
# a collection is first created -- run `rolerag reset-index` + re-ingest to apply it to
# existing collections. Trades a little recall precision for memory at large point counts.
QDRANT_SCALAR_QUANTIZATION=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DEFAULT_TOP_K=10
RAG_CHUNK_SIZE_CHARS=1000
RAG_CHUNK_OVERLAP_CHARS=120
# Opt-in structure-aware chunking (docs/22 P1.3): heading-aware sections + sentence-
# boundary splits + a "<doc title> › <section path>" header line on every chunk. Changes
# chunk text -> chunk ids, so flipping this triggers a natural full re-ingest per source
# (the #86 unchanged-document skip sees a different id set). Default false = byte-
# identical chunking; flip only after the owner-side semantic benchmark (docs/24) shows
# flag-on helps recall/nDCG.
RAG_STRUCTURE_AWARE_CHUNKING=false
RAG_MAX_RETRIEVED_CHUNK_CHARS=800

# Retrieval reranking weights. Defaults mirror app/rag/ranking.py constants; tune
# per campaign. RAG_RECENCY_WEIGHT=0 keeps ranking identical to pre-recency behavior.
RAG_CANDIDATE_OVERSAMPLE_FACTOR=2
RAG_SESSION_MEMORY_WEIGHT=0.08
RAG_PERSONA_MEMORY_WEIGHT=0.04
RAG_CANON_LORE_WEIGHT=0.0
RAG_SESSION_ID_MATCH_BOOST=0.02
RAG_SCENE_ID_MATCH_BOOST=0.04
RAG_PERSONA_ID_MATCH_BOOST=0.03
RAG_IMPORTANCE_STEP_BOOST=0.015
RAG_LEXICAL_MATCH_STEP_BOOST=0.05
RAG_LEXICAL_MATCH_MAX_BOOST=0.25
RAG_RECENCY_WEIGHT=0.0
# Lane B lexical slice quotas (docs/26 §3.4, #79). RAG_SLICE_LEXICAL_QUOTA reserves this many
# prompt slots for the highest session-pool-IDF lexical matches to the player's message, so a
# rare-term direct-answer memory reaches the actor prompt regardless of dense rank. 0 = off
# (byte-identical); the live preset uses 2.
RAG_SLICE_LEXICAL_QUOTA=0
# Minimum summed-IDF score a lexical hit must clear to claim a reserved slot (fix 2). Ships
# UNSET (empty = no floor, matching pre-fix semantics); a measured value is recorded at docs/26
# Stage 5 (#80), not guessed here. Leave empty to disable the floor.
RAG_SLICE_MIN_SCORE=
# Memories below this importance persist in SQLite but are not indexed for retrieval
# (1 = index everything).
RAG_INDEX_IMPORTANCE_FLOOR=1
# Cosine threshold for semantic write-dedup; 1.0 disables it (lexical dedup still runs),
# lower (e.g. 0.92) to drop paraphrased near-duplicate memories.
RAG_WRITE_DEDUP_COSINE_THRESHOLD=1.0
# Cap on session memories kept in the retrievable index (0 = unbounded). Lowest
# importance-then-recency are evicted from the index; SQLite keeps every memory.
SESSION_MEMORY_MAX_EPISODES=0
# Memory consolidation ("sleep cycle"): roll up this many old low-importance,
# non-durable memories into one summary (0 = disabled). Only memories at or below
# MEMORY_CONSOLIDATION_MAX_IMPORTANCE are eligible.
MEMORY_CONSOLIDATION_THRESHOLD=0
MEMORY_CONSOLIDATION_MAX_IMPORTANCE=3
# Minimum-age floor + batch-size cap on the consolidation candidate backlog. Age is
# rank-based (oldest first among eligible memories), no wall-clock dependency.
# 0/0 = no-op (excludes nothing, folds the whole eligible backlog), byte-identical
# to selection before these knobs existed even when consolidation is enabled.
MEMORY_CONSOLIDATION_MIN_AGE=0
MEMORY_CONSOLIDATION_BATCH_CAP=0
# Split the validated SSE response into fragments of this many chars for progressive
# rendering (0 = single frame). Fragments come from the already-validated text only.
SSE_TEXT_CHUNK_CHARS=0

# Pinned session-canon ("Standing facts") injected verbatim into the actor prompt.
CANON_IMPORTANCE_FLOOR=4
CANON_MAX_ITEMS=8
CANON_MAX_CHARS=900
# Lane A tag-eligible canon pinning (docs/26 §3.3, #78), house opt-in pattern identical
# to RAG_RECENCY_WEIGHT. false = byte-identical (importance-floor-only eligibility). true
# widens eligibility to CANON_TAGS-carrying memories below the floor, adds German tag
# aliases, and activates the flag-gated stale-fact supersession safeguard (§3.3.1).
CANON_TAG_PINNING=false

# Critic/curator auto-gating risk thresholds (mirror app/llm/router.py + generation.py).
# A turn counts as risky below this retrieval confidence or at/above this scene
# complexity. Routing does not read these — the session provider is fixed at creation.
# Truncated actor responses retry with this token multiplier.
LOW_RETRIEVAL_CONFIDENCE=0.45
HIGH_SCENE_COMPLEXITY=4
TRUNCATION_RETRY_BUDGET_MULTIPLIER=2
# Output-side containment: fraction of a hidden fact's content words in a reply that
# flags a possible paraphrase/confabulation. Lower = more sensitive. 0.6 caught bake-off leaks.
CONTAINMENT_OVERLAP_THRESHOLD=0.6

RECENT_DIALOGUE_TURNS=8
RECENT_DIALOGUE_MAX_MESSAGE_CHARS=900

# Opt-in context-ceiling preflight (#69). 0 disables entirely (byte-identical
# default). Set to the local model's actual context window (e.g. 8192 for an 8K
# llama.cpp profile) to get an early warning -- never a block -- when the
# estimated (chars/4 heuristic) or actual (from provider usage) prompt+completion
# token count crosses CONTEXT_WARN_RATIO * MODEL_CONTEXT_WINDOW_TOKENS.
MODEL_CONTEXT_WINDOW_TOKENS=0
CONTEXT_WARN_RATIO=0.85

# Leave empty to disable raw structured-output failure logging.
STRUCTURED_OUTPUT_FAILURE_LOG_DIR=

LIVE_TURN_COUNT=8
LIVE_LONG_TURN_COUNT=0
LIVE_FAIL_ON_STRUCTURED_WARNINGS=1

# Harness/dev-only vars read from the process environment, not Settings (keep commented):
# LIVE_HTTP_TIMEOUT_SECONDS=420
#   Per-request HTTP timeout for the live-harness drivers (live_checkpoint, secret_probe).
# EVAL_RESULTS_DIR=eval-runs
#   Where /diagnostics/eval-runs scans for run artifacts (default <repo>/eval-runs).
# DEV_API_PORT=8000
#   Host port published by docker-compose and scripts/dev-up.sh.
